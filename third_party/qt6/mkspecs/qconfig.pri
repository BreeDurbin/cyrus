QT_ARCH = x86_64
QT_BUILDABI = x86_64-little_endian-lp64
QT_LIBCPP_ABI_TAG = 
QT.global.enabled_features = shared rpath reduce_relocations signaling_nan thread future concurrent shared shared rpath reduce_exports reduce_relocations
QT.global.disabled_features = static cross_compile pkg-config debug_and_release separate_debug_info appstore-compliant simulator_and_device force_asserts framework c++20 c++2a c++2b wasm-simd128 wasm-exceptions zstd dbus openssl-linked opensslv11 opensslv30
QT.global.disabled_features += release build_all
QT_CONFIG += shared no-pkg-config rpath reduce_exports reduce_relocations release
CONFIG += release  shared plugin_manifest
QT_VERSION = 6.7.3
QT_MAJOR_VERSION = 6
QT_MINOR_VERSION = 7
QT_PATCH_VERSION = 3

QT_GCC_MAJOR_VERSION = 13
QT_GCC_MINOR_VERSION = 3
QT_GCC_PATCH_VERSION = 0
